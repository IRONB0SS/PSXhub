<pu:WindowX x:Class="PSXhub.NetworkSharing.WPF.WarningWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:PSXhub.NetworkSharing.WPF"
            xmlns:loc="clr-namespace:PSXhub.Localization;assembly=PSXhub.Localization"
            xmlns:pu="https://opensource.panuon.com/wpf-ui"
            mc:Ignorable="d"
            Background="#0d1017"
            Foreground="White"
            Title="{loc:Loc NS9}"
            WindowStartupLocation="CenterScreen"
            ResizeMode="NoResize"
            Height="220"
            Width="360"
            FontFamily="{Binding FontFamily, Mode=OneWay}">
    <Grid
        FlowDirection="{Binding FlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="1"
            FontSize="16"
            TextAlignment="Center"
            VerticalAlignment="Top">
            <Run
                Text="{loc:Loc NS6}"/>
            <Button
                Background="Transparent"
                Margin="0,0,0,-3"
                Padding="0"
                Cursor="Hand"
                Command="{Binding OpenNetworkConnectionsCommand}">
                <TextBlock
                    Foreground="#4493f8"
                    TextDecorations="Underline"
                    FontSize="14"
                    FontWeight="Regular"
                    Text="{loc:Loc NS7}"/>
            </Button>
            <Run
                Text="{loc:Loc NS8}"/>
        </TextBlock>
        <Button
            Grid.Row="2"
            Margin="0"
            VerticalAlignment="Top"
            Width="100"
            Height="30"
            Background="#222931"
            Foreground="#FFFFFF"
            FontSize="14"
            BorderThickness="0"
            Cursor="Hand"
            pu:ButtonHelper.CornerRadius="5"
            pu:ButtonHelper.HoverBackground="#252c34"
            Content="{loc:Loc Ok}"
            Command="{Binding ShutDownCommand}"/>
    </Grid>
</pu:WindowX>
